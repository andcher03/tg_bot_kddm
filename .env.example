# Telegram bot token. Create a new token through BotFather for production.
BOT_TOKEN=replace_with_new_bot_token

# Optional proxy used only for requests to the Telegram Bot API.
# Credentials with special characters must be URL-encoded.
# Examples:
# TELEGRAM_PROXY_URL=socks5://proxy_user:proxy_password@127.0.0.1:1080
# TELEGRAM_PROXY_URL=http://proxy_user:proxy_password@127.0.0.1:8080
TELEGRAM_PROXY_URL=

# Async SQLAlchemy connection string for the production database.
DATABASE_URL=postgresql+asyncpg://kddm_app:replace_with_database_password@127.0.0.1:5432/kddm

# Telegram channel numeric ID (-100...) or public username (@channel_name).
TELEGRAM_CHANNEL_ID=@replace_with_channel_name

# A completely separate database used only by integration tests.
TEST_DATABASE_URL=postgresql+asyncpg://kddm_test:replace_with_test_password@127.0.0.1:5432/kddm_test

# PostgreSQL startup and connection pool settings.
DATABASE_STARTUP_ATTEMPTS=30
DATABASE_STARTUP_DELAY=2.0
DATABASE_CONNECT_TIMEOUT=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Must be enabled when the admin panel is served over HTTPS.
WEB_ADMIN_COOKIE_SECURE=1

# Logs are created automatically for bot, Web Admin and mailing worker.
# A relative path is resolved from the project root on Windows and Linux.
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_LINES=1000

# Durable mailing worker settings.
MAILING_MAX_ATTEMPTS=3
MAILING_STALE_AFTER_SECONDS=300
MAILING_POLL_INTERVAL=1.0
MAILING_THROTTLE_INTERVAL=0.05
